# Frontend API configuration. Set these in Vercel and redeploy.
NEXT_PUBLIC_API_BASE=https://vednix.onrender.com
NEXT_PUBLIC_WS_BASE=wss://vednix.onrender.com/ws/chat

# Local development can omit both values: the browser uses the same host on :8000.
# Never put provider API keys or other secrets in NEXT_PUBLIC_* variables.
