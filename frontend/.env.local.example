# Local development defaults are inferred from localhost/127.0.0.1:
# browser -> http://<same-host>:8000 and ws://<same-host>:8000/ws/chat

# Production defaults are defined in lib/config.ts; these variables override them
# for a different deployment (set in Vercel, then redeploy):
# NEXT_PUBLIC_API_BASE=https://YOUR-RENDER-SERVICE.onrender.com
# NEXT_PUBLIC_WS_BASE=wss://YOUR-RENDER-SERVICE.onrender.com/ws/chat
# Never put provider API keys in NEXT_PUBLIC_* variables.
