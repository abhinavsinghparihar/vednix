# Vednix AI backend settings. Copy to backend/.env and replace only placeholders.
# Provider API keys are entered in Settings; they are encrypted in the backend DB.

# Canonical product creator identity (LinkedIn stays unset until verified).
VEDNIX_CREATOR_NAME=Abhinav Singh
VEDNIX_CREATOR_GITHUB_USERNAME=abhinavsinghparihar
# VEDNIX_CREATOR_LINKEDIN_URL=https://www.linkedin.com/in/<verified-profile>

# Provider request behavior
VEDNIX_LLM_TEMPERATURE=0.7
VEDNIX_LLM_REQUEST_TIMEOUT=90

# Server
VEDNIX_HOST=0.0.0.0
VEDNIX_PORT=8000
VEDNIX_CORS_ORIGINS=https://vednix.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database, persistent data directory, and uploads
VEDNIX_DATA_DIR=./data
VEDNIX_DATABASE_URL=sqlite+aiosqlite:///./data/vednix.db
VEDNIX_UPLOAD_DIR=./data/uploads
VEDNIX_UPLOAD_MAX_MB=15

# Persistent machine secret (recommended in production so container restarts
# never invalidate login sessions or encrypted provider API keys)
# VEDNIX_SECRET_KEY=replace-with-a-long-random-secret

# Input and conversation context limits
VEDNIX_MAX_MESSAGE_CHARS=32000
VEDNIX_HISTORY_MAX_TURNS=40
VEDNIX_MEMORY_CONTEXT_ITEMS=5

# Optional research service
VEDNIX_SEARXNG_URL=http://localhost:8080
# VEDNIX_SEARCH_MAX_RESULTS=5
# VEDNIX_SEARCH_FETCH_PAGES=3

# Optional shared rate limiter
# VEDNIX_REDIS_URL=redis://localhost:6379/0

# Optional bearer token for API-level protection
# VEDNIX_AUTH_TOKEN=replace-with-a-long-random-value

# Optional email OTP login (use an app password, not an account password)
# VEDNIX_SMTP_HOST=smtp.example.com
# VEDNIX_SMTP_PORT=587
# VEDNIX_SMTP_USERNAME=your-address@example.com
# VEDNIX_SMTP_PASSWORD=your-app-password
# VEDNIX_SMTP_FROM=your-address@example.com
# VEDNIX_SMTP_STARTTLS=true
# VEDNIX_OTP_TTL_SECONDS=600
