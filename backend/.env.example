# ---- Vednix AI backend configuration ----
# Copy to .env and adjust. All values have safe local-development defaults.

# Ollama (local LLM runtime)
VEDNIX_OLLAMA_HOST=http://localhost:11434
VEDNIX_OLLAMA_MODEL=qwen2.5:3b
VEDNIX_LLM_TEMPERATURE=0.7

# Server
VEDNIX_HOST=127.0.0.1
VEDNIX_PORT=8000
VEDNIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database (SQLite by default; swap for Postgres later)
VEDNIX_DATABASE_URL=sqlite+aiosqlite:///./data/vednix.db

# Guards
VEDNIX_MAX_MESSAGE_CHARS=32000
VEDNIX_HISTORY_MAX_TURNS=40

# ---- Phase 5: provider / internet / infra ----
# LLM provider: ollama (offline default) or openrouter (cloud, needs key)
VEDNIX_LLM_PROVIDER=ollama
# VEDNIX_OPENROUTER_API_KEY=
# VEDNIX_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VEDNIX_OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Gemini text chat uses Google's OpenAI-compatible API. No Gemini key belongs in env/frontend;
# add it in Vednix Settings so it is encrypted in the backend database.
VEDNIX_GEMINI_MODEL=gemini-3.8-flash

# Internet research (SearXNG — self-host: docker run -p 8080:8080 searxng/searxng)
VEDNIX_SEARXNG_URL=http://localhost:8080
# VEDNIX_SEARCH_MAX_RESULTS=5
# VEDNIX_SEARCH_FETCH_PAGES=3

# Infra switches (all off by default)
# VEDNIX_REDIS_URL=redis://localhost:6379/0   # shared rate limiting
# VEDNIX_AUTH_TOKEN=change-me                 # bearer-gates /api/* and /ws/chat

# Multi-agent deep research (bounded loops)
# VEDNIX_AGENTS_MAX_ITERATIONS=2
# VEDNIX_AGENTS_MAX_SUBQUESTIONS=4

# Secure email OTP login (Gmail: use an App Password, never your normal password)
# VEDNIX_SMTP_HOST=smtp.gmail.com
# VEDNIX_SMTP_PORT=587
# VEDNIX_SMTP_USERNAME=youraddress@gmail.com
# VEDNIX_SMTP_PASSWORD=your-16-character-gmail-app-password
# VEDNIX_SMTP_FROM=youraddress@gmail.com
# VEDNIX_SMTP_STARTTLS=true
# VEDNIX_OTP_TTL_SECONDS=600

# Google OAuth is intentionally not enabled until real credentials are supplied.
# VEDNIX_GOOGLE_CLIENT_ID=
# VEDNIX_GOOGLE_CLIENT_SECRET=
# VEDNIX_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
